},
{
  "name": "foreign_with_us_fallback",
  "priority": 40,
  "patterns": [
    { "regex": "(?i)(beer\\s*sheva|budapest|jerusalem|san\\s*juan).*?(ny|nj|fl|ca|tx)", "colocator": "FA:XX", "status": "owners", "action": "match" }
  ]
},
{
  "name": "census_strip_suites",
  "description": "Suite/unit/# stripped in census_strip stage before Census retry (colocator round 4dp)",
  "priority": 5,
  "patterns": [
    {
      "regex": "(?i)[,\\s]+(?:suite|ste\\.?|apt\\.?|apartment|unit|rm\\.?|room|fl\\.?|floor|bldg\\.?|building)\\s*#?\\s*(?:\\d+[a-z0-9-]*|[a-z](?:\\d+|(?=\\s*,|\\s*$)))",
      "action": "strip"
    },
    {
      "regex": "(?i)[,\\s]+#\\s*\\d+[a-z0-9-]*",
      "action": "strip"
    },
    {
      "regex": "(?i)[,\\s]+\\d{1,4}(?=,\\s*[A-Za-z])",
      "action": "strip"
    }
  ]
},
{
  "name": "normalized_preprocess",
  "description": "Predicates on normalized_address JSON (street/city/state/zip) — preferred over canonical regex",
