{
  "name": "suite_pmb_box_junk",
  "priority": 20,
  "patterns": [
    { "regex": "(?i)\\b(suite|ste|pmb|apt|box)\\s*\\d+.*?(collections?|mail|svc|center|paysphere)", "colocator": "PO:MAIL", "status": "owners", "action": "match" }
  ]
},
{
  "name": "address_unknown_placeholders",
  "priority": 30,
  "patterns": [
    { "regex": "(?i)address\\s*unknown|no\\s*street\\s*address|000\\s*address", "colocator": "PO:UNKNOWN", "status": "owners", "action": "match" },
    { "regex": "(?i)\\d+-?xxx-?\\d+", "colocator": "PO:UNKNOWN", "status": "owners", "action": "match" },
    { "regex": "(?i)\\bxxxx+\\b|\\bx{3,}\\b", "colocator": "BOGUS:{zip}", "status": "owners", "action": "match" },
    { "regex": "(?i)^(not releasable|not to be published|confidential location|please email instead|home address)\\b", "colocator": "BOGUS:{zip}", "status": "owners", "action": "match" },
    { "regex": "(?i)^(same as(?:\\s+(?:above|below|c\\s+above))?|see statement|see schedule|no address|unable to locate)\\b", "colocator": "BOGUS:{zip}", "status": "owners", "action": "match" },
    { "regex": "(?i)^(oth|telehealth|general telehealth|remote telehealth)\\b", "colocator": "BOGUS:{zip}", "status": "owners", "action": "match" }
