    {
      "name": "incomplete_addresses",
      "description": "Mark incomplete addresses",
      "regex": "(?i)^(n/a|na|street|road|avenue|drive|way|lane|place|court|circle|boulevard|parkway|available|unavailable|unknown address|unknown)$",
      "colocator": "BOGUS:{zip}",
