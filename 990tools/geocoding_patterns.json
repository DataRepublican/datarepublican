{
  "version": "1.3",
  "description": "Geocoding patterns for automatic resolution of common IRS 990 address issues. v1.3: grok residual free-wins (foreign cities bootstrap, state/zip mismatch, narrative/lockbox/military).",
  "patterns": [
    {
      "name": "privacy_addresses",
      "description": "Addresses that charities choose not to disclose",
      "regex": "(?i)(Individual Contrbutions|Trustee Maintains List Of Addresses|available upon request|upon request|on file|address available on request|see.*attached|attached|Detailed Address Information)",
      "colocator": "PRIV:{zip}",
      "status": "owner",
      "priority": 1
    },
    {
      "name": "exempt_addresses",
      "description": "Addresses that charities claim are exempt from disclosure",
      "regex": "(?i)(exempt)",
      "colocator": "EXEMPT:{zip}",
      "status": "owner",
      "priority": 1
    },
    {
      "name": "mail_drop_addresses",
      "description": "All variants of PO Box / Box / Ppbox / Podrawer / Post Office (covers the new batch + legacy)",
      "regex": "(?i)(p[0o]\\.?\\s*o\\.?\\s*(?:box|drawer)|po\\s*box|po\\s*bpx|ppbox|podrawer|post\\s*office|box\\s*\\d+|rr\\s*\\d+\\s*box|\\bdrawer\\s+[a-z0-9#]+)",
      "colocator": "PO:{box}:{zip}",
      "status": "owner",
      "priority": 2
    },
    {
      "name": "co_addresses",
      "description": "Care-of addresses (expanded for the heavy C/O batch)",
      "regex": "(?i)^c/?o\\s+(.+?)(?:,|$)",
      "action": "strip",
      "colocator": "CO:{entity}:{zip}",
      "status": "owner",
      "priority": 3
    },
    {
      "name": "department_lockbox",
      "description": "Department / Lockbox / Credit Card Processing / Remittance codes (huge slice in new batch)",
      "regex": "(?i)(dept|department|lockbox|credit card processing|upper midwest lockbox|us bank lockbox|file|contributions gifts grants paid)",
      "colocator": "DEPT:{code}:{zip}",
      "status": "owner",
      "priority": 4
    },
    {
      "name": "rural_route",
      "description": "Rural Route (Rr) boxes",
      "regex": "(?i)^rr\\s*\\d+\\s*box",
      "colocator": "RR:{box}:{zip}",
      "status": "owner",
      "priority": 5
    },
    {
      "name": "person_as_address",
      "description": "Person name used as entire address (Treasurer, Controller, etc.)",
      "regex": "(?i)^(treas|treasurer|sec|secretary|controller|dir|director|pres|president|rick|rick niemeier|tina ferrigno|beverly euculano|diane ruth|cris banton|stevie hedrick|theodore w meyers)",
      "colocator": "PERSON:{name}:{zip}",
      "status": "owner",
      "priority": 6
    },
    {
      "name": "university_internal",
      "description": "University / org internal mail codes (Ch10189, Cm12, etc.)",
      "regex": "(?i)(univ development|colyer hall|development office|research and sponsored programs|cm12|cb 3235|mail code|dept ch)",
      "colocator": "UNIV:{code}:{zip}",
      "status": "owner",
      "priority": 7
    },
    {
      "name": "registered_agents_2025",
      "description": "Top registered agent firms + military/gov (unchanged from your file)",
      "priority": 8,
      "patterns": [
        {"regex": "(?i)c/?o\\s+ct\\s+corporation\\s+system", "colocator": "RA:CT_CORP", "status": "owner"},
        {"regex": "(?i)c/?o\\s+corporation\\s+service\\s+company", "colocator": "RA:CSC", "status": "owner"},
        {"regex": "(?i)c/?o\\s+national\\s+registered\\s+agents", "colocator": "RA:NRAI", "status": "owner"},
        {"regex": "(?i)c/?o\\s+northwest\\s+registered\\s+agent", "colocator": "RA:NORTHWEST", "status": "owner"},
        {"regex": "(?i)c/?o\\s+incorp\\s+services", "colocator": "RA:INCORP", "status": "owner"},
        {"regex": "(?i)c/?o\\s+registered\\s+agent\\s+solutions", "colocator": "RA:RAS", "status": "owner"},
        {"regex": "(?i)c/?o\\s+paracorp", "colocator": "RA:PARACORP", "status": "owner"},
        {"regex": "(?i)c/?o\\s+cogency\\s+global", "colocator": "RA:COGENCY", "status": "owner"},
        {"regex": "(?i)c/?o\\s+united\\s+states\\s+corporation\\s+agents", "colocator": "RA:USCA", "status": "owner"},
        {"regex": "(?i)c/?o\\s+capitol\\s+corporate\\s+services", "colocator": "RA:CAPITOL", "status": "owner"},
        {"regex": "(?i)c/?o\\s+the\\s+corporation\\s+trust\\s+company", "colocator": "RA:CTC", "status": "owner"},
        {"regex": "(?i)c/?o\\s+harvard\\s+business\\s+services", "colocator": "RA:HARVARD", "status": "owner"},
        {"regex": "(?i)c/?o\\s+delaware\\s+registered\\s+agent", "colocator": "RA:DELAWARE", "status": "owner"},
        {"regex": "(?i)c/?o\\s+legalzoom", "colocator": "RA:LEGALZOOM", "status": "owner"},
        {"regex": "(?i)c/?o\\s+blumbergexcelsior", "colocator": "RA:BLUMBERG", "status": "owner"},
        {"regex": "(?i)c/?o\\s+agents\\s+and\\s+corporations", "colocator": "RA:AGENTS_CORP", "status": "owner"},
        {"regex": "(?i)(apo|dpo|fpo)\\s+[a-z]+\\s+\\d+", "colocator": "MILITARY:APO", "status": "owner"},
        {"regex": "(?i)c/?o\\s+department\\s+of\\s+state", "colocator": "GOV:STATE_DEPT", "status": "owner"},
        {"regex": "(?i)c/?o\\s+embassy", "colocator": "GOV:EMBASSY", "status": "owner"},
