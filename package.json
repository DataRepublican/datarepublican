{
  "scripts": {
    "build:css": "postcss assets/css/main.css -o assets/css/styles.css",
    "watch:css": "postcss assets/css/main.css -o assets/css/styles.css --watch",
    "start": "run-p watch:css jekyll:serve",
    "jekyll:serve": "bundle exec jekyll serve --incremental --livereload",
    "test:browse": "vitest run",
    "demo:browse": "npx playwright test tests/browse_sankey.spec.js --project=demo"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "npm-run-all": "^4.1.5",
    "vitest": "^3.2.7"
  }
}
