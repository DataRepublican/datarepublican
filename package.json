{
  "scripts": {
    "build": "npm run data:split && npm run build:css && JEKYLL_ENV=production bundle exec jekyll build --destination _site",
    "build:css": "postcss assets/css/main.css -o assets/css/styles.css",
    "watch:css": "tailwindcss -i assets/css/main.css -o assets/css/styles.css --postcss postcss.config.js --watch=always",
    "clean": "rm -rf _site .jekyll-metadata",
    "dev:watchdirs": "mkdir -p test-results playwright-report",
    "start": "npm run clean && npm run dev:watchdirs && npm run data:split && npm run build:css && run-p watch:css jekyll:serve",
    "jekyll:serve": "bundle exec jekyll serve --destination _site --incremental",
    "serve:build": "ruby -run -e httpd _site -p 4000",
    "test": "playwright test",
    "test:routes": "scripts/check-routes.sh",
    "data:split": "node scripts/split-noblogs-data.mjs"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tailwindcss/typography": "^0.5.16",
    "npm-run-all": "^4.1.5"
  }
}
